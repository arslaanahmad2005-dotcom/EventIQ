# ==============================================================================
# EventIQ - Production Environment Configuration Template
# Copy this file to .env and configure your production values.
# NEVER commit your actual .env file with secrets into version control.
# ==============================================================================

# [CRITICAL] AI API Key (Required for AI Recommendation Engine)
# Get a key from Google AI Studio (https://aistudio.google.com/)
AI_API_KEY=

# AI Provider: 'gemini' (default, Google Gemini 2.5 Flash) or 'openai' (GPT-4o-mini)
AI_PROVIDER=gemini

# Application Environment: 'production' or 'development'
NODE_ENV=production

# Server Port (default: 3001)
PORT=3001

# CORS Allowed Origins (Comma-separated list of exact domains allowed to access the API)
# Wildcards (*) are strictly forbidden in production.
# Example: https://eventiq.yourdomain.com,https://api.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Debug Mode: Strictly defaults to false (OFF)
# Set to 'true' only in local development when verbose internal tracing is needed.
DEBUG=false

# [OPTIONAL] Database Connection URL (PostgreSQL / MongoDB)
# In production, connections MUST enforce TLS/SSL (e.g., ?sslmode=require or ?tls=true)
# Weak/default credentials (e.g. postgres:postgres) are rejected automatically.
# DATABASE_URL=postgresql://user:secure_password@db.example.com:5432/eventiq?sslmode=require

# [OPTIONAL] Authentication Secret (Minimum 32 characters required in production)
# AUTH_SECRET=your_32_character_minimum_random_secret_key_here
